    {
      "id": "q007",
      "type": "single-choice",
      "prompt": "Why should you use `StringBuilder` when concatenating thousands of strings in a loop?",
      "options": [
        {
          "id": "a",
          "text": "`string` cannot hold >1000 chars"
        },
        {
          "id": "b",
          "text": "`string` is immutable, so `+` in a loop allocates a new string copy every iteration ($O(n^2)$); `StringBuilder` mutates an internal buffer"
        },
        {
          "id": "c",
          "text": "`StringBuilder` is thread-safe"
        },
        {
          "id": "d",
          "text": "`+` throws an exception"
        }
      ]
    },

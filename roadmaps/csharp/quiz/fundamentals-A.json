      "prompt": "Why is `decimal` preferred over `double` for financial and currency calculations in C#?",
      "options": [
        {
          "id": "a",
          "text": "`decimal` is faster in hardware"
        },
        {
          "id": "b",
          "text": "`decimal` is 8 bytes"

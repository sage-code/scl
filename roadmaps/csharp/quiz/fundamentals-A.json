    {
      "id": "q002",
      "type": "single-choice",
      "prompt": "What is the key difference between `var` and `dynamic` in C#?",
      "options": [
        {
          "id": "a",
          "text": "`var` is mutable; `dynamic` is constant"
        },
        {
          "id": "b",
          "text": "`dynamic` is faster than `var`"
        },
        {
          "id": "c",
          "text": "`var` is statically typed via compile-time inference; `dynamic` defers member resolution to runtime"
        },
        {
          "id": "d",
          "text": "They are identical"
        }
      ]
    },
    {

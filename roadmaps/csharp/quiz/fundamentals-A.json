        {
          "id": "c",
          "text": "`double` cannot store negative numbers"
        },
        {
          "id": "d",
          "text": "`decimal` uses base-10 floating-point representation, avoiding binary rounding errors like `0.1 + 0.2 != 0.3`"
        }
      ]

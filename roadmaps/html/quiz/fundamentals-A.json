    {
      "id": "q015",
      "type": "single-choice",
      "prompt": "How does a relative URL such as `images/logo.png` differ from an absolute URL?",
      "options": [
        {
          "id": "a",
          "text": "It always names a different website."
        },
        {
          "id": "b",
          "text": "It is resolved relative to a base URL, commonly the current document URL."
        },
        {
          "id": "c",
          "text": "It cannot be used in an `img` element."
        },
        {
          "id": "d",
          "text": "It always begins with `https://`."
        }
      ]
    },
    {
      "id": "q016",
      "type": "multi-select",
      "prompt": "Select all that apply: which statements about hyperlinks are correct?",
      "options": [
        {
          "id": "a",
          "text": "An `a` element with `href` creates a hyperlink."
        },
        {
          "id": "b",
          "text": "A fragment such as `#details` can point to an element with that ID."
        },
        {
          "id": "c",
          "text": "An anchor with no `href` is automatically a link to the current page."
        },
        {
          "id": "d",
          "text": "`href` can contain a web URL or a supported URL scheme such as `mailto:`."
        }
      ]
    },
    {

    {
      "id": "q001",
      "type": "single-choice",
      "prompt": "What is the main purpose of `<!doctype html>` at the start of a modern HTML document?",
      "options": [
        {
          "id": "a",
          "text": "It imports the browser's default CSS."
        },
        {
          "id": "b",
          "text": "It tells the browser to use standards mode for HTML."
        },
        {
          "id": "c",
          "text": "It declares the page's character encoding."
        },
        {
          "id": "d",
          "text": "It creates the root `html` element."
        }
      ]
    },
    {

      "id": "q001",
      "type": "single-choice",
      "prompt": "How does Nim primarily achieve C-level runtime performance while keeping Python-like syntax?",
      "options": [
        {
          "id": "a",
          "text": "Via a JVM JIT compiler"
        },
        {
          "id": "b",
          "text": "By compiling statically typed Nim source to C, C++, or JavaScript"
        },
        {
          "id": "c",
          "text": "By interpreting bytecode at runtime"
        },
        {
          "id": "d",
          "text": "By embedding Python CPython"
        }
      ]
    },

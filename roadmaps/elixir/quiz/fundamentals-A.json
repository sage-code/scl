        },
        {
          "id": "b",
          "text": "The Erlang BEAM virtual machine"
        },
        {
          "id": "c",
          "text": "The V8 JavaScript engine"
        },
        {
          "id": "d",
          "text": "A standalone LLVM native runtime with no VM"
        }
      ]
    },
    {
      "id": "q002",
      "type": "single-choice",
      "prompt": "Compared to Python and Rust, where does Elixir sit in typical system trade-offs?",
      "options": [
        {
          "id": "a",
          "text": "Elixir compiles to unboxed machine code with manual lifetimes like Rust"
        },
        {
          "id": "b",
          "text": "Elixir uses a Global Interpreter Lock (GIL) like CPython"
        },
        {
          "id": "c",
          "text": "Elixir prioritizes soft real-time concurrency and fault tolerance on BEAM rather than raw single-threaded CPU speed"
        },
        {
          "id": "d",
          "text": "Elixir cannot call native code or run across multiple CPU cores"
        }
      ]
    },

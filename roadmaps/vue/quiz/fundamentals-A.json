    {
      "id": "q008",
      "type": "single-choice",
      "prompt": "What is the main difference between `ref()` and `reactive()` in Vue 3?",
      "options": [
        {
          "id": "a",
          "text": "`reactive()` works with primitives like `number`; `ref()` only works with objects"
        },
        {
          "id": "b",
          "text": "`reactive()` is deprecated"
        },
        {
          "id": "c",
          "text": "`ref()` wraps any value (primitives or objects) via `.value`; `reactive()` wraps objects/arrays directly with a Proxy"
        },
        {
          "id": "d",
          "text": "`ref()` is not reactive"
        }
      ]

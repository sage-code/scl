      "id": "q001",
      "type": "single-choice",
      "prompt": "Which design philosophy best describes the Odin programming language?",
      "options": [
        {
          "id": "a",
          "text": "Automatic garbage collection with class-based inheritance"
        },
        {
          "id": "b",
          "text": "Data-oriented, procedural, explicit systems programming without hidden allocations or exceptions"
        },
        {
          "id": "c",
          "text": "Pure functional programming with immutable data on a virtual machine"
        },
        {
          "id": "d",
          "text": "Dynamic scripting with implicit type coercion"
        }
      ]
    },

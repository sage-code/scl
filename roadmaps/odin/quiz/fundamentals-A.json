    {
      "id": "q007",
      "type": "single-choice",
      "prompt": "In Odin, what is the difference between `:=` and `::`?",
      "options": [
        {
          "id": "a",
          "text": "`:=` is for strings; `::` is for integers"
        },
        {
          "id": "b",
          "text": "`:=` declares a global variable; `::` declares a local variable"
        },
        {
          "id": "c",
          "text": "`:=` declares a runtime variable with inferred type; `::` declares a compile-time constant"
        },
        {
          "id": "d",
          "text": "They are identical synonyms"
        }
      ],
      "code": {
        "language": "odin",
        "source": "PI :: 3.14159\nradius := 2.0"
      }
    },

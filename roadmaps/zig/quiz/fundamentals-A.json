      "id": "q001",
      "type": "single-choice",
      "prompt": "Which core design principle distinguishes Zig from C++ and Rust?",
      "options": [
        {
          "id": "a",
          "text": "Automatic garbage collection"
        },
        {
          "id": "b",
          "text": "No hidden control flow, no hidden memory allocations, and no preprocessor macros"
        },
        {
          "id": "c",
          "text": "Mandatory OOP inheritance"
        },
        {
          "id": "d",
          "text": "Dynamic typing by default"
        }
      ]
    },
    {

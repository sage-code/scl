        }
      ]
    },
    {
      "id": "q003",
      "type": "single-choice",
      "prompt": "What is the difference between `const` and `var` in Zig?",
      "options": [
        {
          "id": "a",
          "text": "`const` is only for integers"
        },
        {
          "id": "b",
          "text": "`const` cannot be inside a function"
        },
        {
          "id": "c",
          "text": "`var` is heap-allocated"
        },
        {
          "id": "d",
          "text": "`const` declares an immutable binding; `var` declares a mutable variable"
        }
      ]
    },
    {
      "id": "q004",
      "type": "multi-select",
      "prompt": "Select all valid statements about Zig's `undefined` keyword. (Select all that apply.)",
      "options": [
        {
          "id": "a",
          "text": "`undefined` is identical to `null`"
        },
        {
          "id": "b",
          "text": "`var buf: [64]u8 = undefined;` leaves memory uninitialized without zeroing it"
        },
        {
          "id": "c",
          "text": "Useful for performance when a buffer will be overwritten immediately"
        },
        {
          "id": "d",
          "text": "In Debug/ReleaseSafe builds, Zig fills `undefined` with `0xaa` bytes to help catch uninitialized reads"
        }
      ]
    },

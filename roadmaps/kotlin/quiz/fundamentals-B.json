    {
      "id": "q001",
      "type": "single-choice",
      "prompt": "Why does `if (x is String) println(x.length)` compile without an explicit cast?",
      "options": [
        {
          "id": "a",
          "text": "`Any` has `.length`"
        },
        {
          "id": "b",
          "text": "`is` mutates `x`'s type globally"
        },
        {
          "id": "c",
          "text": "Kotlin's compiler performs a smart cast of `x` to `String` inside the `if` branch"
        },
        {
          "id": "d",
          "text": "Reflection"
        }
      ],
      "code": {
        "language": "kotlin",
        "source": "fun printLen(x: Any) {\n    if (x is String) println(x.length)\n}"
      }
    },

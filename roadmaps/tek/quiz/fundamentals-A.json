      "prompt": "In Linux permissions, what does `chmod 750 deploy.sh` grant?",
      "options": [
        {
          "id": "a",
          "text": "Read/write/execute for everyone"
        },
        {
          "id": "b",
          "text": "Owner: r-x (5), Group: rwx (7), Others: r-- (4)"
        },
        {
          "id": "c",
          "text": "Owner: rwx (7), Group: r-x (5), Others: none (0)"
        },
        {
          "id": "d",
          "text": "Execute-only for root"
        }
      ],
      "code": {
        "language": "bash",
        "source": "chmod 750 deploy.sh\nls -l deploy.sh"
      }

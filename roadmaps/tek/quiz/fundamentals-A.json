      "prompt": "What is the difference between `SIGTERM` (`kill -15`) and `SIGKILL` (`kill -9`)?",
      "options": [
        {
          "id": "a",
          "text": "`SIGTERM` asks the process to shut down gracefully (allowing cleanup); `SIGKILL` terminates immediately at the kernel level"
        },
        {
          "id": "b",
          "text": "`SIGKILL` runs `defer` cleanup handlers first"
        },
        {
          "id": "c",
          "text": "`SIGTERM` cannot stop a process"
        },
        {
          "id": "d",
          "text": "They are identical"
        }

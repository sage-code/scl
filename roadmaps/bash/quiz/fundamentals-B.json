      "id": "q001",
      "type": "single-choice",
      "prompt": "What does `${PORT:-8080}` evaluate to in Bash parameter expansion?",
      "options": [
        {
          "id": "a",
          "text": "Sets `PORT=8080` permanently"
        },
        {
          "id": "b",
          "text": "Throws an error if `PORT` is unset"
        },
        {
          "id": "c",
          "text": "Returns `$PORT` if set and non-empty, otherwise evaluates to `8080` without modifying `PORT`"
        },
        {
          "id": "d",
          "text": "Returns the length of `PORT`"
        }
      ],
      "code": {
        "language": "bash",
        "source": "port=\"${PORT:-8080}\""
      }
    },

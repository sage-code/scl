    {
      "id": "q003",
      "type": "single-choice",
      "prompt": "Why does `name = \"Ada\"` fail in Bash?",
      "options": [
        {
          "id": "a",
          "text": "Bash requires single quotes"
        },
        {
          "id": "b",
          "text": "`=` is only for numbers"
        },
        {
          "id": "c",
          "text": "Variables must start with `$` on assignment"
        },
        {
          "id": "d",
          "text": "Spaces around `=` cause Bash to treat `name` as a command with `=` and `\"Ada\"` as arguments"
        }
      ]
    },
    {
      "id": "q004",
      "type": "multi-select",
      "prompt": "Select all differences between single quotes `'...'` and double quotes `\"...\"` in Bash. (Select all that apply.)",
      "options": [
        {
          "id": "a",
          "text": "Single quotes expand `$HOME` automatically"
        },
        {
          "id": "b",
          "text": "Single quotes preserve every character literally (no `$var` or `$(cmd)` expansion)"
        },
        {
          "id": "c",
          "text": "Double quotes expand `$var` and `$(cmd)` while preventing word splitting and globbing"
        },
        {
          "id": "d",
          "text": "Double quotes allow escaping `\\$` and `\\\"`"
        }
      ]

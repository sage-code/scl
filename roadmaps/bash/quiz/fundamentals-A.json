      "type": "single-choice",
      "prompt": "Why is `printf '%s\\n' \"$msg\"` preferred over `echo \"$msg\"` for arbitrary strings?",
      "options": [
        {
          "id": "a",
          "text": "`echo` cannot print variables"
        },
        {
          "id": "b",
          "text": "`echo` is removed in Bash 5"

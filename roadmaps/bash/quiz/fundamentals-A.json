      "id": "q001",
      "type": "single-choice",
      "prompt": "What is the recommended portable shebang line for a Bash script?",
      "options": [
        {
          "id": "a",
          "text": "`#!/bin/sh`"
        },
        {
          "id": "b",
          "text": "`#!/usr/bin/env bash`"
        },
        {
          "id": "c",
          "text": "`#include <bash>`"
        },
        {
          "id": "d",
          "text": "`//bin/bash`"
        }
      ],
      "code": {
        "language": "bash",
        "source": "#!/usr/bin/env bash"
      }
    },
    {

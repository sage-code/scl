# Line endings of the scl repo (site, roadmap, projects; the Eve tutorial is projects/eve).
# The index and the working tree are LF for every text file, whatever core.autocrlf says
# (eol= overrides it). GitHub Desktop, Vercel builds, the browsers and the code samples of
# the roadmap all read LF. CRLF is kept only for the Windows script types below.

# Default: let Git detect text, store and check out LF.
* text=auto eol=lf

# Site and data: declared so detection never guesses wrong.
*.html text eol=lf diff=html
*.htm  text eol=lf diff=html
*.css  text eol=lf diff=css
*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf diff=markdown
*.xml  text eol=lf
*.svg  text eol=lf
*.txt  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.csv  text eol=lf
*.sql  text eol=lf
*.py   text eol=lf diff=python
*.sh   text eol=lf
*.eve  text eol=lf
*.ipynb text eol=lf
*.drawio text eol=lf

# Windows scripts: cmd.exe and PowerShell 5.1 expect CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# UTF-16 files (written by PowerShell): never convert.
final-report.json   -text
projects/eve/output.log -text

# Binary files: no line-ending change, no text diff.
*.png  binary
*.jpg  binary
*.jpeg binary
*.jfif binary
*.gif  binary
*.webp binary
*.avif binary
*.ico  binary
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary
*.pdf  binary
*.zip  binary
*.exe  binary
*.dll  binary

# exceptions: errors with a code and a message, $error, recover and resume
** chapter: 26 Exceptions (exceptions.html)
driver exceptions is

  function ratio(a, b: Integer) => (@result: Real) is
    let result := a / b;              ** a division by zero raises an error
  return;

  process main is
    divide: job
    do
      print ratio(10, 0);
    done divide;

    index: job
    do
      new l := (1, 2, 3);
      print l[5];                     ** indexes start at 1 and stop at the count
    done index;

    disk: job
    do
      raise ($err_io, "disk full");   ** an error with a code and a message
    done disk;

    check: job
    do
      expect 1 + 1 == 3;              ** a failed expect is an error too
    done check;

    plain: job
    do
      raise "something odd";          ** without a code: $err_raise, 4
    done plain;

    print "every error was handled";
  recover
    print "{$error.job}: code {$error.code}, {$error.message}";
    expect $error.code == $err_io if $error.job == "disk";
    resume;
  return;
end exceptions;

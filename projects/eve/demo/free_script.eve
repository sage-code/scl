#!/usr/bin/env eve
# a free script: statements in sequence, no driver, no process
** chapter: 08 Scripts (scripts.html)
** shows: the shortest program; when it needs functions or aspects, it becomes a macro (macro.html)

new total = 0 :Integer;
new words := ("data", "is", "the", "new", "code");

for w in words do
  let total += w.length();
done;

print "{words.count()} words, {total} letters";
expect total == 16;

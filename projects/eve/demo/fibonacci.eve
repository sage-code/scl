# Fibonacci function demo
driver fibonacci is

  ** a function with a result and no side effects: deterministic
  function fib(n: Integer) => (@y: Integer) is
    if n < 2 do
      let y := n;                     ** fib(0) = 0, fib(1) = 1
    else
      let y := fib(n - 1) + fib(n - 2);
    done;
  return;

  process main is
    let r := fib(5);
    expect r == 5;
    print r;
  return;
end fibonacci;

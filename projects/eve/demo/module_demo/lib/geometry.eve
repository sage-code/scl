# geometry: a module with a constant, a class, an extension method and a function
** used by ../module_demo.eve
module geometry is
  export (UNIT, Point, distance2);   ** the extension method shift comes with Point

  set UNIT = 1 :Integer;

  class Point = {x, y :Integer} <: Object is
    constructor(x = 0, y = 0 :Integer) => (@self) is
      let self := Object();
      let self.x := x;
      let self.y := y;
    return;
  end Point;

  ** extension method: Point gets the method shift
  method shift(@self: Point, dx, dy: Integer) is
    let self.x += dx;
    let self.y += dy;
  return;

  ** a function, not a method: it belongs to no object
  function distance2(a, b: Point) => (@result: Integer) is
    let result := (b.x - a.x) ^ 2 + (b.y - a.y) ^ 2;      ** the square of the distance
  return;

  initialize
    print "geometry: loaded";
end geometry;

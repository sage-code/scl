# control flow: if, match, while, for, loop ... repeat, jobs come later
** chapter: 05 Control Flow (control.html)
driver control_flow is

  process main is
    ** if, else if, else; a conditional statement and a conditional expression
    new n := 7;
    if n < 5 do
      print "small";
    else if n < 10 do
      print "medium";
    else
      print "large";
    done;
    print "n is odd" if n % 2 <> 0;
    new size := ("big" if n > 5 else "small");

    ** match: values, lists of values, ranges, other
    match n
      when (1..5) do
        print "low";
      when (6..10) do
        print "high";
      when other do
        print "out of range";
    done;

    ** while with a header, break and then
    loop
      new i := 1;
      new sum := 0;
    while i <= 5 do
      let sum += i;
      let i += 1;
    then
      print "sum 1..5 = {sum}";
    done;

    ** for over a range with a step; skip and break
    new odd := "";
    for i in (1..20)(1) do
      skip if i % 2 == 0;
      break if i > 9;
      let odd <+ "{i} ";
    done;
    print "odd: {odd}";

    ** a labelled loop: skip and break may name the outer loop
    new pairs := 0;
    outer: loop
    for i in (1..3) do
      for j in (1..3) do
        skip outer if j > i;
        let pairs += 1;
      done;
    done outer;

    ** loop ... repeat: the body runs at least once
    new k := 10;
    loop do
      let k += 1;
    repeat while k < 5;

    expect size == "big" and pairs == 6 and k == 11;
  return;
end control_flow;

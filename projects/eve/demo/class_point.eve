# a class with a constructor, methods and visibility
** chapter: 20 Classes (classes.html)
driver point_demo is

  ** the attributes are declared in the signature; Object is the root class
  class Point = {x, y: Real} <: Object is

    ** the result of a constructor is the new object: @self
    constructor(x = 0, y = 0: Real) => (@self) is
      let self := Object();           ** the first statement builds the object
      let self.x := x;
      let self.y := y;
    return;

    public method shift(@self, dx, dy: Real) is
      let self.x += dx;
      let self.y += dy;
    return;

    public method text(@self) => (@result: String) is
      let result := "(x:{self.x}, y:{self.y})";
    return;
  end Point;

  process main is
    new p1 := Point(x: 1, y: 2);
    new p2 := Point(2, 2);
    new origin := Point();            ** the defaults
    p2.shift(1, 1);
    print "p1 = {p1.text()}";
    print "p2 = {p2.text()}";
    print "origin = {origin.text()}";
    expect p1 is Point;
  return;
end point_demo;

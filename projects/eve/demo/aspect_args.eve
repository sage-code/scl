# an aspect that is run: constants, system variables, command-line arguments, recover and finalize
** chapter: 09 Aspects (aspects.html)
** run: eve aspect_args.eve alpha beta
aspect aspect_args is

  ** constants of the script and a system variable of the run
  set greeting = "Hello" :String;
  set $epsilon = 0.01;

  ** the process main is the entry point; *args collects the command-line arguments
  process main(*args) is
    if args.count() == 0 do
      print "{greeting}, nobody: give some names on the command line";
    else
      for name in args do
        print "{greeting}, {name}!";
      done;
    done;
    expect 1.0 =~ 1.005;              ** equal within $epsilon
    raise "something went wrong" if args.count() > 3;
  recover
    print "recovered: {$error.message}";
  finalize
    print "done";                     ** runs on every path
  return;
end aspect_args;

# functions: results, defaults, named arguments, recursion, deterministic and stochastic
** chapter: 14 Functions (functions.html)
driver functions is

  ** deterministic: the same arguments always give the same result
  function greet(name: String, greeting = "Hello") => (@result: String) is
    let result := "{greeting}, {name}!";
  return;

  function fact(n: Integer) => (@result: Integer) is
    if n <= 1 do
      let result := 1;
    else
      let result := n * fact(n - 1);
    done;
  return;

  ** two results, received by two names
  function min_max(values: ()Integer) => (@low: Integer, @high: Integer) is
    let low := values[1];
    let high := values[1];
    for v in values do
      let low := v if v < low;
      let high := v if v > high;
    done;
  return;

  ** stochastic: the name ends with ! because the result can differ for the same
  ** arguments; here the function keeps a counter in a closure (see closures.eve)
  function make_ticket!() => (@next!: Function) is
    new last := 0;
    function next!() => (@result: Integer) is
      let last += 1;
      let result := last;
    return;
  return;

  process main is
    print greet("Eve");
    print greet(greeting: "Hi", name: "Ann");      ** named arguments, any order
    expect fact(5) == 120;
    new low, high := min_max((7, 3, 9, 1));
    print "low {low}, high {high}";

    new ticket! := make_ticket!();
    print ticket!(), ticket!(), ticket!();         ** 1,2,3: same call, other result
  return;
end functions;

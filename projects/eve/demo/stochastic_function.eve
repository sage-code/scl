# deterministic and stochastic functions
driver stochastic_demo is

  ** deterministic: the same arguments always give the same result
  function square(x: Integer) => (@y: Integer) is
    let y := x * x;
  return;

  ** stochastic: the result can differ for the same arguments, the name ends with !
  ** the mark says nothing about thread safety: this function changes no shared state,
  ** so the compiler also finds it thread safe
  function roll!() => (@n: Integer) is
    let n := (1..6).random();
  return;

  process main is
    expect square(4) == 16;
    new r := roll!();
    expect (r >= 1) and (r <= 6);
    print "rolled {r}";
  return;
end stochastic_demo;

# subprograms: procedures and functions, parameters by value and by reference
** chapter: 13 Subprograms (subprograms.html)
driver subprograms is

  ** a procedure has no result: @ passes by reference, no @ passes a copy
  procedure swap(@x, @y: Integer) is
    new t := x;
    let x := y;
    let y := t;
  return;

  procedure bump(n: Integer) is
    let n += 1;                       ** changes the copy only
  return;

  ** optional parameters have a default; a vararg collects the rest
  function total(first: Integer, *rest: ()Integer, scale = 1: Integer) => (@r: Integer) is
    let r := first;
    for v in rest do
      let r += v;
    done;
    let r := r * scale;
  return;

  ** several results
  function divmod(a, b: Integer) => (@q: Integer, @r: Integer) is
    new t = a / b :Integer;
    let q := t;
    let r := a % b;
  return;

  ** defer runs when the procedure ends, on every path
  procedure work(name: String) is
    defer print "end of {name}";
    print "start of {name}";
  return;

  process main is
    new a := 1;
    new b := 2;
    swap(@a, @b);
    expect a == 2 and b == 1;

    new k := 5;
    bump(k);
    expect k == 5;

    expect total(1, 2, 3) == 6;
    expect total(1, 2, 3, scale: 10) == 60;
    new q, r := divmod(17, 5);
    print "17 = 5 * {q} + {r}";
    work("job");
  return;
end subprograms;

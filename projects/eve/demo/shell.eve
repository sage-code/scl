# shell commands: run a command and take its output
** chapter: 39 Shell Commands (command.html)
** preview: level 5 (version 0.4, F-LIB-07); the VM does not run it yet
driver shell is
  set files: ()String;

  process main is
    ** call runs a shell command; +> sends its output lines into a list
    call "cd {$HOME}/test";
    call "ls -l *.dat" +> files;
    for file in files do
      print file;
    done;

    ** arguments go to a script with +>
    call ("hello", "world") +> "./shell_test.sh";
  return;
end shell;

# strings: immutable text, interpolation, formats, split, join and regular expressions
** chapter: 06 Strings (strings.html)
driver strings is

  process main is
    new s := "Hello";
    new t := s + " World";
    expect t.length() == 11;
    expect s[1] == 'H' and s[-1] == 'o';
    expect "ab" * 3 == "ababab";

    ** <+ appends a number as text; + between a string and a number is an error
    expect ("item" <+ 7) == "item7";

    ** interpolation: a name, a literal or a simple expression
    new n := 42;
    new pi := 3.14159;
    print "n = {n}, next = {n + 1}, name = {s.length()} letters";

    ** formats: width, fill, alignment, decimals
    print "[{n % i5}] [{n % 0>i5}] [{pi % f8.2}] [{s % *^9}]";

    ** escapes and Unicode
    print "alpha = {U+03B1}, braces = \{x\}";

    ** split and join
    new parts := "red,green,blue".split(',');
    expect parts.count() == 3;
    print parts.join(" | ");

    ** a text literal keeps its line breaks
    new poem := """
      Roses are red,
      violets are blue.
      """;
    print poem;

    ** regular expressions: a string that starts with / is a pattern
    expect "this is like" =~ "/l.ke$/";
    expect "ABC" =~ "/abc/i";
    expect "order 123" =~ "/\d\d\d$/";

    ** the old value of a string never changes
    new r := s;
    let s <+ "!";
    expect r == "Hello" and s == "Hello!";
  return;
end strings;

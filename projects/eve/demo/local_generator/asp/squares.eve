# the sum of the squares 1, 4, 9, ... n * n
concurrent aspect squares is

  ** private to the aspect: it runs on the core of its task and has one owner,
  ** so it can use any variable of the aspect and needs no atomic or mutex
  generator squares_to(n: Integer) => (@x: Integer) is
    for i in (1..n) do
      yield i * i;
    done;
  return;

  process main(n: Integer, @sum: Integer) is
    let sum := 0;
    for s in squares_to(n) do
      let sum += s;
    done;
  return;
end squares;

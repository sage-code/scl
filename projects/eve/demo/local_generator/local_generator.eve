# a generator local to an aspect needs no thread safety
** project layout: asp/squares.eve (aspect), this driver
driver local_generator is
  process main is
    new s: [4]Integer;

    parallel
    do
      for i in (1..4) do
        start squares(i * 10, @s[i]);
      done;
    done;

    print s;                          ** [385,2870,9455,22140]
  return;
end local_generator;

# callbacks: a function given to another function, by name or as a lambda
** chapter: 18 Callbacks (callbacks.html)
driver callbacks is

  ** a function type: the signature a callback must have
  class BinEx = (p1, p2 :Integer):Integer <: Function;

  function double(x: Integer) => (@y: Integer) is
    let y := x * 2;
  return;

  ** the receiver calls action for every element
  procedure each(items: ()Integer, action: Function) is
    for x in items do
      write "{action(x)} ";
    done;
    print;
  return;

  ** a typed callback: only a function with two Integer parameters fits
  procedure combine(a, b: Integer, op: BinEx) is
    print "combine({a}, {b}) = {op(a, b)}";
  return;

  ** a fold: the callback joins the elements one by one
  function fold(items: ()Integer, initial: Integer, op: BinEx) => (@result: Integer) is
    let result := initial;
    for x in items do
      let result := op(result, x);
    done;
  return;

  process main is
    each((1, 2, 3), double);                  ** by name: 2 4 6
    each((1, 2, 3), (x) => (x + 100));        ** a lambda: 101 102 103
    combine(6, 7, (a, b) => (a * b));
    expect fold((1, 2, 3, 4), 0, (a, b) => (a + b)) == 10;
    print "product: {fold((1, 2, 3, 4), 1, (a, b) => (a * b))}";
  return;
end callbacks;

# the shortest program: one aspect, one process main
** chapter: 08 Scripts (scripts.html)
** shows: any aspect runs as a driver; when it needs aspects of its own, it becomes a macro (macro.html)

aspect word_count is
  process main is
    new total = 0 :Integer;
    new words := ("data", "is", "the", "new", "code");

    for w in words do
      let total += w.length();
    done;

    print "{words.count()} words, {total} letters";
    expect total == 16;
  return;
end word_count;

# shared statistics: an atomic variable makes the functions thread safe
module stats is
  export (hit, hits!);

  ** atomic: every operation is indivisible, the operating system orders the threads
  new total = Atomic(:Integer)(0);

  ** no result: adds one, nothing is lost when many tasks call it at once
  function hit() is
    total.add(1);
  return;

  ** stochastic: the value changes while the workers run
  function hits!() => (@result: Integer) is
    let result := total.get!();
  return;
end stats;

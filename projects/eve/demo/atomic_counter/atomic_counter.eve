# four workers, one shared counter
** project layout: lib/stats.eve (module), asp/worker.eve (aspect), this driver
driver atomic_counter is
  from "lib" use (stats);

  process main is
    parallel
    do
      for w in (1..4) do
        start worker(1000);           ** four tasks, each one counts 1000 jobs
      done;
    done;

    ** all the tasks have finished: no hit is lost
    let n := stats.hits!();
    expect n == 4000;
    print "hits: \#{n}";
  return;
end atomic_counter;

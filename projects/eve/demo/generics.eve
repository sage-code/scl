# generics: a generic class takes a type; a constraint asks for a trait
** chapter: 22 Generics (generics.html)
driver generics is

  ** Box holds an item of any type T
  class Box(:T) = {item: T} <: Object is
    public method get(@self) => (@result: T) is
      let result := self.item;
    return;
  end Box;

  ** Pair needs a type that can be compared
  class Pair(:T <: Comparable) = {a: T, b: T} <: Object is
    public method larger(@self) => (@result: T) is
      let result := (self.a if self.a.compare(self.b) > 0 else self.b);
    return;
  end Pair;

  process main is
    new n := Box(:Integer)(item: 5);
    new s := Box(:String)(item: "five");
    print n.get() + 1, s.get();       ** 6,five
    print Pair(:Integer)(a: 3, b: 7).larger();
    print Pair(:String)(a: "pear", b: "apple").larger();
  return;
end generics;

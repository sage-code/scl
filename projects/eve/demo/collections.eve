# collections: list, DataSet, DataMap, Object, builders and deconstruction
** chapter: 07 Collections (collections.html)
driver collections is

  process main is
    ** a list: the first index is 1, a negative index counts from the end
    new a := (1, 2, 3);
    expect a[1] == 1 and a[-1] == 3;
    let a <+ 4;                       ** append at the end
    a.delete(2);                      ** remove every element equal to 2
    expect a == (1, 3, 4);

    ** capture: the element that leaves the list goes into a name
    new q := (10, 20, 30);
    new head <- q;
    let q -> new tail;
    expect head == 10 and tail == 30 and q == (20,);

    ** builders: an expression, a range or a collection, an optional condition
    new squares := (x ^ 2 | x in (1..5));
    new evens := (x | x in (1..10) and x % 2 == 0);
    print squares, evens;

    ** deconstruct: _ skips, *rest collects
    new first, _, *rest :: (1, 2, 3, 4, 5);
    expect first == 1 and rest == (3, 4, 5);

    ** DataSet: sorted unique values and set operations
    new s := {3, 1, 2, 3};
    expect s == {1, 2, 3};
    expect ({1, 2, 3} || {3, 4}) == {1, 2, 3, 4};
    expect ({1, 2, 3} && {2, 3, 4}) == {2, 3};

    ** DataMap: sorted key: value pairs
    new stock := {"apple": 5, "pear": 2};
    let stock["plum"] := 7;
    let stock["apple"] += 1;
    for (k: v) in stock do
      print "{k}: {v}";
    done;

    ** Object: unquoted keys make an object with attributes
    new p := {x: 1, y: 2};
    let p.x := 3;
    expect p.x + p.y == 5;

    ** := shares a collection, :: makes a deep copy
    new view := a;
    new copy :: a;
    let view <+ 9;
    expect a.count() == 4 and copy.count() == 3;
  return;
end collections;

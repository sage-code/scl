# partials: an abstract class and a trait leave methods for the subclass to write
** chapter: 23 Partials (partials.html)
driver partials is

  ** a trait: one required method and one provided method
  trait Describable is
    method describe(@self) => (@result: String);
    method show(@self) is
      print "<{self.describe()}>";
    return;
  end Describable;

  ** an abstract class: area has no body, so Shape is built only by a subclass
  class Shape = {name: String} <: Object is
    constructor(name :String) => (@self) is
      let self := Object();
      let self.name := name;
    return;

    public method area(@self) => (@result: Real);

    public method report(@self) => (@result: String) is
      let result := "{self.name}: {self.area()}";
    return;
  end Shape;

  ** Square writes the missing method and adopts the trait
  class Square = {side: Real} <: (Shape, Describable) is
    constructor(side :Real) => (@self) is
      let self := Shape("square");
      let self.side := side;
    return;

    public method area(@self) => (@result: Real) is
      let result := self.side * self.side;
    return;

    public method describe(@self) => (@result: String) is
      let result := "a square of side {self.side}";
    return;
  end Square;

  process main is
    new q := Square(2.5);
    print q.report();                 ** square: 6.25
    q.show();                         ** provided by the trait
    expect q is Shape and q is Describable;
  return;
end partials;

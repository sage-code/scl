# a generator exported by a module is shared by every task: it must be thread safe
** project layout: lib/tickets.eve (module), asp/clerk.eve (aspect), this driver
driver module_generator is
  from "lib" use (tickets);

  process main is
    new first: [3]Integer;

    parallel
    do
      for i in (1..3) do
        start clerk(5, @first[i]);    ** every clerk takes 5 tickets
      done;
    done;

    ** the 15 tickets are 1 to 15, no number was given twice
    let n := tickets.taken!();
    expect n == 15;
    print "tickets taken: {n}";
  return;
end module_generator;

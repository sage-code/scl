# a module with a plain variable: not thread safe
module plain is
  export (hit, count!);

  new total = 0 :Integer;             ** plain: two tasks can lose an update

  function hit() is
    let total += 1;                   ** read, add, write: not indivisible
  return;

  function count!() => (@result: Integer) is
    let result := total;
  return;
end plain;

# the compiler rejects a task that calls a function that is not thread safe
** project layout: lib/plain.eve (module), asp/worker.eve (aspect), this driver
driver unsafe_counter is
  from "lib" use (plain);

  process main is
    ** worker is an exclusive aspect: it is applied, never started
    apply worker(1000);

    ** compile error, start of an exclusive aspect:
    ** parallel
    ** do
    **   start worker(1000);
    ** done;
    ** and if worker were declared "concurrent aspect", the error would be in worker.eve:
    ** plain.hit() changes a plain module variable, it is not thread safe
    let n := plain.count!();
    print "count: {n}";
  return;
end unsafe_counter;

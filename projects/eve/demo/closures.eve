# closures: a function made by a function keeps the state it was made with
** chapter: 16 Closures (closures.html)
driver closures is

  ** make_counter! makes a new counter at every call; next! keeps current alive
  function make_counter!(first: Integer) => (@next!: Function) is
    new current := first;
    function next!() => (@result: Integer) is
      let current += 1;
      let result := current;
    return;
  return;

  ** a closure that remembers a parameter: a deterministic function made at run time
  function make_scale(factor: Integer) => (@scale: Function) is
    function scale(x: Integer) => (@result: Integer) is
      let result := x * factor;
    return;
  return;

  process main is
    new a! := make_counter!(0);
    new b! := make_counter!(10);
    print a!(), a!();                 ** 1,2
    print b!(), b!();                 ** 11,12
    print a!();                       ** 3: a and b have their own state

    new triple := make_scale(3);
    expect triple(5) == 15;
    print "triple 7 = {triple(7)}";
  return;
end closures;

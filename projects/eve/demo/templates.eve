# templates: an HTML page from a template file, text from a user is never code
** chapter: 30 Templates (templates.html)
** preview: level 7 (version 0.6, F-WEB-01); the template is order.evh, next to this file;
** the VM does not run it yet
driver templates is
  from "lib" use (html);

  class Order = {id: Integer, customer: String, status: String} <: Object;

  process main is
    ** a string template: fine for text, unsafe for a page
    new count := 3;
    print "Ann, you have {count} new orders.";

    ** an HTML template: every value is escaped, so "<b>" stays text
    new o := Order(id: 42, customer: "Ann <b>", status: "open");
    new page: Html := html.render("order.evh", o: o);   ** Html, not String
    html.write("out/order42.html", page);

    ** a value of type Html is made only by a template or by html.escape
    new safe: Html := html.escape("<script>steal()</script>");
    print safe;                       ** &lt;script&gt;steal()&lt;/script&gt;
  return;
end templates;

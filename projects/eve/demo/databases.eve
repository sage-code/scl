# databases: a session, records, find, update, append and commit
** chapter: 27 Databases (databases.html)
** preview: level 5 (version 0.4, F-DAT-01); the syntax follows the page and waits for the
** decisions of Q-043 (records, transactions, bulk loads); the VM does not run it yet
driver databases is
  from $EVE_LIB/db use (core as db);

  ** a record type: the fields of a row
  class Order = {id: Integer, customer: String, amount: Decimal} <: Record;

  process main is
    new session := db.connect("eve");             ** the Eve database (SQLite)
    new orders := session.table("orders");

    ** append a record
    new o := orders.append();
    update o:
      let customer := "Ann";
      let amount := 120.50d;
    commit;

    ** find a record and change it
    new found := orders.find(customer: "Ann");
    update found:
      let amount := 99.90d;
    commit;

    ** read the rows with a query
    for row in db.query("select id, amount from orders") do
      print "{row.id}: {row.amount}";
    done;
  finalize
    session.disconnect();
  return;
end databases;

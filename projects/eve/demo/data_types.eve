# data types: literals, ordinals, ranges, conversions and optional values
** chapter: 03 Data Types (types.html)
driver data_types is

  ** an ordinal is a set of named integer values; the first is 1 unless given
  class Color = {Red, Green, Blue} <: Ordinal;
  class Level = {Low:10, High} <: Ordinal;

  process main is
    ** the type of a literal
    expect type(42) is Integer;
    expect type(0.5) is Real;
    expect type(12.50d) is Decimal;
    expect type(255b) is Byte;
    expect type('a') is Rune;
    expect type("a") is String;
    expect type(True) is Logic;
    expect 255 == 0xFF and 5 == 0b101;

    ** ordinals
    expect Green == 2;
    expect High == 11;

    ** a range is a domain of values: limits included or excluded, a step
    expect 0.5 in (0.0..1.0);
    expect 1 not in (0..<1);
    expect 0.25 in (0..1)(0.01);
    expect 999 in (0..?);

    ** a division gives a Real; explicit conversions do what you ask
    new half := 7 / 2;
    expect half == 3.5;
    new whole = 7 / 2 :Integer;
    expect whole == 3;
    expect floor(1.5) == 1 and ceiling(1.5) == 2 and round(1.5) == 2;
    expect Integer.parse("1000") == 1000;

    ** a variable without a value has the zero value of its type, never null
    new s :String;
    expect s == "";
    ** an optional type T? may hold null
    new o :String?;
    expect o is Null;
    let o := "text";
    expect o is not Null;

    print "half = {half}, whole = {whole}, color = {Blue}";
  return;
end data_types;

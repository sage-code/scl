# multitasking: async subprograms take turns on one core inside a job
** chapter: 28 Multitasking (multitasking.html)
driver multitasking is

  ** an async procedure gives its core away while it waits
  async procedure fetch(name: String, delay: Integer, @size: Integer) is
    print "fetch {name}: start";
    wait 10ms;
    let size := name.length() * delay;
    print "fetch {name}: done";
  return;

  async function double(n: Integer) => (@result: Integer) is
    wait 5ms;
    let result := n * 2;
  return;

  process main is
    new a, b, c :Integer;
    ** spawn starts a task and goes on; await waits for a result; done waits for all
    work: job
    do
      spawn fetch("orders", 3, @a);
      spawn fetch("customers", 3, @b);
      let c := await double(21);
    done work;
    print "sizes {a} and {b}, double {c}";
  return;
end multitasking;

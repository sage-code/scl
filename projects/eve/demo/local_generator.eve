# a generator local to an aspect needs no thread safety
** chapter: 29 Concurrency (concurrency.html#generators-and-threads)
** preview: level 5 (version 0.4, generators); the VM does not run it yet

** squares: the sum of the squares 1, 4, 9, ... n * n
concurrent aspect squares is

  ** private to the aspect: it runs on the core of its task and has one owner,
  ** so it can use any variable of the aspect and needs no atomic or mutex
  generator squares_to(n: Integer) => (@x: Integer) is
    for i in (1..n) do
      yield i * i;
    done;
  return;

  process main(n: Integer, @sum: Integer) is
    let sum := 0;
    for s in squares_to(n) do
      let sum += s;
    done;
  return;
end squares;

driver local_generator is
  process main is
    new s: [4]Integer;
    parallel
    do
      for i in (1..4) do
        start squares(i * 10, @s[i]);
      done;
    done;
    print s;                          ** [385,2870,9455,22140]
  return;
end local_generator;

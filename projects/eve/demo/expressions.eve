# expressions: operators, conditional expressions, ranges, builders and lambdas
** chapter: 17 Expressions (lambdas.html)
driver expressions is

  ** a lambda is an anonymous function held by a constant
  set sum = (a, b :Integer) => (a + b) :Integer;

  process main is
    ** arithmetic and its precedence: ^ before * before +
    expect 2 + 3 * 4 ^ 2 == 50;
    expect 17 % 5 == 2;
    expect 7 / 2 == 3.5;

    ** relations and logic
    new n := 12;
    expect (n > 10) and not (n > 20);
    expect (n in (0..4)) or (n in (12..24));
    expect 3.14159 =~ 3.14 +- 0.01;   ** equal within a tolerance

    ** a conditional expression
    new kind := ("even" if n % 2 == 0 else "odd");

    ** builders: an expression over a range, with a condition
    new cubes := (x ^ 3 | x in (1..4));
    new odd := {x | x in (1..9) and x % 2 == 1};

    ** a collection and a scalar: the operator applies to every element
    new prices := (10, 20, 30);
    new doubled := prices * 2;

    ** lambdas: held by a name, called by the name
    new double := (x) => (x * 2);
    expect double(21) == 42;
    expect sum(2, 3) == 5;

    print "{n} is {kind}; cubes {cubes}; odd {odd}; doubled {doubled}";
  return;
end expressions;

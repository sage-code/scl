# the standard library: built-in procedures and functions, no import needed
** chapter: 35 Standard Library (library.html)
** planned built-ins (not in the VM yet): abs, min, max, sqrt, pi, read
driver library is

  process main is
    ** standard output: print ends the line and separates with sep, write does neither
    print "a", "b", "c";              ** a,b,c
    print "a", "b", "c", sep: " ";    ** a b c
    write "no new line, ";
    write "then one";
    print;

    ** types and conversions
    expect type(3.5) is Real;
    expect floor(2.7) == 2 and ceiling(2.1) == 3 and round(2.5) == 3;
    expect Integer.parse("42") + 1 == 43;
    expect Real.parse("2.5") * 2 == 5.0;

    ** text and collections
    new words := "one two three".split(' ');
    expect words.count() == 3;
    expect words.join("+") == "one+two+three";
    expect "three".length() == 5;

    ** compare gives -1, 0 or 1 for numbers and texts (the trait Comparable)
    expect 3.compare(5) == -1 and "b".compare("a") == 1;

    ** split and batch cut a list into parts
    new parts := (1, 2, 3, 4, 5, 6, 7).batch(3);
    print "batches: {parts.count()}, last: {parts[-1]}";
  return;
end library;

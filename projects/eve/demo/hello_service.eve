# a service: routes that answer HTTP requests
** chapter: 33 Server (server.html)
** preview: level 6 (version 0.5, F-STR-08, F-NET-02); a service is not a driver: the machine
** loads it with "eve serve"; the VM does not run it yet
service hello_api is

  ** GET /hello/Ann answers {"message": "Hello, Ann"}
  route greet(req: Request, @res: Response) on get "/hello/{name}" is
    let res.body := {"message": "Hello, " + req.params["name"]}.json();
  end greet;

  ** POST /echo answers the body it received
  route echo(req: Request, @res: Response) on post "/echo" is
    let res.status := 200;
    let res.body := req.body;
  end echo;

  initialize
    print "hello_api: ready";
  finalize
    print "hello_api: stopped";
end hello_api;

# two accounts guarded by one mutex
module bank is
  export (transfer, total!);

  new alice = 100 :Integer;
  new bob   = 100 :Integer;

  ** one mutex guards both variables: an atomic variable can't change two values together
  new lock = Mutex();

  ** moves an amount from alice to bob
  function transfer(amount: Integer) is
    lock.acquire();                   ** waits while another task holds the mutex
    defer lock.release();             ** released on every path, also after an error
    let alice -= amount;
    let bob   += amount;
  return;

  ** the sum of both accounts, read while no transfer is half done
  function total!() => (@result: Integer) is
    lock.acquire();
    defer lock.release();
    let result := alice + bob;
  return;
end bank;

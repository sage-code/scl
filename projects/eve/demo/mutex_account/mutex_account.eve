# a transfer changes two variables: they must change together
** project layout: lib/bank.eve (module), asp/teller.eve (aspect), this driver
driver mutex_account is
  from "lib" use (bank);

  process main is
    parallel
    do
      start teller(500, 3);           ** moves 3 from alice to bob, 500 times
      start teller(500, -2);          ** moves 2 from bob to alice, 500 times
    done;

    ** the sum never changes: no transfer was seen half done
    let sum := bank.total!();
    expect sum == 200;
    print "total: {sum}";
  return;
end mutex_account;

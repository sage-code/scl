# dates, times and durations
** chapter: 04 Date and Time (datetime.html)
** preview: level 5 (version 0.4, F-LIB-06); the VM does not run it yet
driver dates is

  process main is
    ** parse a date with a format
    new start := "2023/06/15".parse(YMD);
    new found := "07/04/1776 AD".parse(MDY);
    expect start > found;
    print "year {start.year}, month {start.month}";

    ** build a date from its fields
    new battle = {era: CE, year: 1066, month: 10, day: 14} :Date;
    print battle;

    ** a time of day and a duration
    new noon := "12:00:00, 0ms".parse(T24);
    expect noon.h == 12;
    new pause = {sec: 1} :Duration;
    print pause;                      ** 1000ms

    ** format a date for printing
    print start as YMD;               ** 2023/06/15
  return;
end dates;

# a tour of the syntax: comments, declarations, statements and expressions
## chapter: 02 Syntax (syntax.html)
/* A block comment spans lines and does not nest.
   The first line of the file says what the file is: # is a title, #! a free script. */
driver syntax_tour is

  ** set makes a constant of the script; new makes a variable
  set limit = 3 :Integer;
  set language = "Eve";

  process main is
    ** = declares with a type, := infers the type from the value
    new count = 0 :Integer;
    new ratio := 2.5;
    new name := language;

    ** every change starts with let; a change without let is an error
    let count += 2;
    let count *= limit;
    let name <+ "!";                  ** append to a string
    new b := 1 + (** an expression comment **) 2;

    ** a statement ends with ; so an expression may span several lines
    new total := count * 10
               + b;

    ** a statement may end with a condition
    print "big total" if total > 50;

    ** print separates its arguments with sep and ends the line, write does neither
    print name, count, ratio;         ** Eve!,6,2.5
    print (1, 2, 3, sep: " ");        ** 1 2 3
    write "total = ";
    write total;
    print;                            ** ends the line: total = 63
    expect total == 63;
  return;
end syntax_tour;

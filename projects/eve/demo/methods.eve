# methods: public and private methods, extension methods, a library trait
** chapter: 24 Methods (methods.html)
driver methods is

  class Account = {owner: String, balance: Integer} <: (Object, Printable) is
    constructor(owner :String) => (@self) is
      let self := Object();
      let self.owner := owner;
      let self.balance := 0;
    return;

    public method deposit(@self, amount: Integer) is
      self.check(amount);
      let self.balance += amount;
    return;

    ** private: only the methods of the class can call it
    private method check(@self, amount: Integer) is
      raise "amount must be positive" if amount <= 0;
    return;

    ** Printable: print uses describe
    public method describe(@self) => (@result: String) is
      let result := "{self.owner}: {self.balance}";
    return;
  end Account;

  ** an extension method: added to Account outside the class
  method withdraw(@self: Account, amount: Integer) is
    raise "not enough money" if amount > self.balance;
    let self.balance -= amount;
  return;

  process main is
    new a := Account("Ann");
    a.deposit(100);
    a.withdraw(30);
    print a;                          ** Ann: 70
    a.withdraw(500);
  recover
    print "refused: {$error.message}";
  return;
end methods;

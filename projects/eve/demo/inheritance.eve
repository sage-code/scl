# inheritance: a subclass builds its object through the constructor of its superclass
** chapter: 21 Inheritance (inheritance.html)
driver inheritance is

  class Animal = {name: String} <: Object is
    constructor(name :String) => (@self) is
      let self := Object();
      let self.name := name;
    return;

    public method describe(@self) => (@result: String) is
      let result := "{self.name} is an animal";
    return;
  end Animal;

  ** Dog inherits name and describe, and adds its own attribute and method
  class Dog = {breed: String} <: Animal is
    constructor(name, breed :String) => (@self) is
      let self := Animal(name);
      let self.breed := breed;
    return;

    public method bark(@self) => (@result: String) is
      let result := "{self.name} the {self.breed} says woof";
    return;
  end Dog;

  process main is
    new rex := Dog("Rex", "beagle");
    print rex.describe();             ** inherited from Animal
    print rex.bark();
    expect rex is Dog;
    expect rex is Animal;             ** a Dog is also an Animal
    new kitty := Animal("Kitty");
    expect kitty is not Dog;
  return;
end inheritance;

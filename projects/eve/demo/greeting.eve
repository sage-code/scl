# the system library: standard input and files
** chapter: 36 System Library (syslib.html)
** preview: level 5 (version 0.4, F-LIB-04 files and paths); the VM does not run it yet
driver greeting is
  from $EVE_LIB use (fs);

  process main is
    ** read a line from the standard input
    new name := "";
    read(name, "name: ");
    print "Hello,", name;

    ** write a file, then read it one line at a time
    new path := "out/greeting.txt";
    fs.write(path, "Hello\n{name}\n");
    for line in fs.lines(path) do
      print "> {line}";
    done;
  return;
end greeting;

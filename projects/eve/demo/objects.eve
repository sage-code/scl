# objects: object literals, attributes, comparison, references and copies
** chapter: 19 Objects (objects.html)
driver objects is

  process main is
    ** unquoted keys make an object; quoted keys make a DataMap
    new p := {x: 1.5, y: 2};
    new m := {"x": 1.5, "y": 2};
    expect p.x == 1.5;
    expect m["x"] == 1.5;

    ** attributes change with let; an attribute can't be added from outside
    let p.x := 3;

    ** == compares the attributes, is compares the identity
    new q := {x: 3, y: 2};
    expect p == q;
    expect p is not q;

    ** := gives a second name to the same object, :: makes a copy
    new same := p;
    new copy :: p;
    let same.y := 10;
    expect p.y == 10;
    expect copy.y == 2;

    ** a list of objects
    new people := ({name: "Ann", age: 31}, {name: "Bob", age: 45});
    for person in people do
      print "{person.name} is {person.age}";
    done;
  return;
end objects;

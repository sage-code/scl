# algorithms: a square root with a precision, a sort, a binary search, a greatest common divisor
** chapter: 38 Algorithms (algorithms.html)
driver algorithms is

  ** the default precision of =~ and of root
  set $epsilon = 0.0001;

  ** Newton: improve z until z * z is close enough to x
  function root(x: Real, p = $epsilon: Real) => (@z: Real) is
    let z := 1.0;
    loop do
      let z -= (z * z - x) / (2 * z);
    repeat while (z * z - x if z * z > x else x - z * z) > p;
  return;

  ** bubble sort: swap neighbours until nothing moves
  procedure sort(@items: ()Integer) is
    new moved := True;
    while moved do
      let moved := False;
      for i in (1..<items.count()) do
        if items[i] > items[i + 1] do
          new t := items[i];
          let items[i] := items[i + 1];
          let items[i + 1] := t;
          let moved := True;
        done;
      done;
    done;
  return;

  ** binary search in a sorted list: the index of x, or 0
  function find(items: ()Integer, x: Integer) => (@at: Integer) is
    new low := 1;
    new high := items.count();
    let at := 0;
    while low <= high do
      new mid = (low + high) / 2 :Integer;
      if items[mid] == x do
        let at := mid;
        break;
      else if items[mid] < x do
        let low := mid + 1;
      else
        let high := mid - 1;
      done;
    done;
  return;

  ** Euclid
  function gcd(a, b: Integer) => (@r: Integer) is
    let r := (a if b == 0 else gcd(b, a % b));
  return;

  process main is
    expect root(2.0) =~ 1.41421;
    print "root(10) = {root(10.0) % f8.4}";

    new data := (31, 4, 15, 9, 26, 5);
    sort(@data);
    print data;                       ** 4,5,9,15,26,31
    expect find(data, 15) == 4;
    expect find(data, 7) == 0;
    expect gcd(84, 36) == 12;
  return;
end algorithms;

    {
      "id": "q001",
      "type": "single-choice",
      "prompt": "Why should every modern Fortran program unit and module start with `implicit none`?",
      "options": [
        {
          "id": "a",
          "text": "It enables garbage collection"
        },
        {
          "id": "b",
          "text": "It disables legacy implicit I-N integer / real typing so undeclared or misspelled variables are caught at compile time"
        },
        {
          "id": "c",
          "text": "It makes all variables constants"
        },
        {
          "id": "d",
          "text": "It enables OpenMP"
        }
      ],
      "code": {
        "language": "fortran",
        "source": "program main\n  implicit none\n  integer :: count\nend program main"
      }
    },

-- 18 - Test/build script: compiles the bit_util package spec + body
-- Run in SQL*Plus / sqlcl: @18_bit_util.pkc

whenever sqlerror exit failure rollback
whenever oserror exit failure rollback

set echo off

@@16_bit_util.pks
show errors

@@17_bit_util.pkb
show errors

-- exercise the package once it is compiled
set serveroutput on
begin
  dbms_output.put_line('5 OR 3  = ' || bit_util.bitor(5, 3));   -- 7
  dbms_output.put_line('5 XOR 3 = ' || bit_util.bitxor(5, 3));  -- 6
  dbms_output.put_line('NOT 5   = ' || bit_util.bitnot(5));     -- -6
  dbms_output.put_line('5 << 1  = ' || bit_util.bitlsh(5, 1));  -- 10
  dbms_output.put_line('5 >> 1  = ' || bit_util.bitrsh(5, 1));  -- 2
end;
/

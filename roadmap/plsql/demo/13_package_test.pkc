-- 13 - Test/build script: compiles hello_world's spec + body, then calls both
-- Run in SQL*Plus / sqlcl: @13_package_test.pkc

whenever sqlerror exit failure rollback
whenever oserror exit failure rollback

set echo off
set serveroutput on

@@11_package_spec.pks
show errors

@@12_package_body.pkb
show errors

begin
  dbms_output.put_line(hello_world.say_hello); -- function, used in an expression
  hello_world.hello;                            -- procedure, called as a statement
end;
/

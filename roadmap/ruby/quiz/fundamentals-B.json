      "id": "q001",
      "type": "single-choice",
      "prompt": "What does `yield` do inside a Ruby method?",
      "options": [
        {
          "id": "a",
          "text": "Pauses a thread"
        },
        {
          "id": "b",
          "text": "Returns `nil`"
        },
        {
          "id": "c",
          "text": "Invokes the block passed by the caller"
        },
        {
          "id": "d",
          "text": "Raises an exception"
        }
      ],
      "code": {
        "language": "ruby",
        "source": "def wrap\n  puts \"before\"\n  yield if block_given?\nend"
      }
    },
    {
      "id": "q002",
      "type": "single-choice",
      "prompt": "What is the key difference between a `Proc` and a `lambda` regarding argument count (arity)?",
      "options": [
        {
          "id": "a",
          "text": "`Proc` raises `ArgumentError` on wrong args; `lambda` ignores extras"
        },
        {
          "id": "b",
          "text": "Neither accepts arguments"
        },
        {
          "id": "c",
          "text": "Both ignore argument count"
        },
        {
          "id": "d",
          "text": "`lambda` enforces exact argument count; `Proc` fills missing args with `nil` and ignores extras"
        }
      ]
    },
    {
      "id": "q003",
      "type": "single-choice",
      "prompt": "What happens when `return` is executed inside a `lambda` vs a `Proc`?",
      "options": [
        {
          "id": "a",
          "text": "In a `lambda`, `return` exits only the lambda; in a `Proc`, `return` exits the enclosing method"
        },
        {
          "id": "b",
          "text": "Both exit the enclosing method"
        },
        {
          "id": "c",
          "text": "In a `lambda`, `return` is a syntax error"
        },
        {
          "id": "d",
          "text": "Both exit only themselves"
        }
      ]
    },
    {
      "id": "q004",
      "type": "single-choice",
      "prompt": "What does `a ||= 10` do in Ruby when `a` is `false`?",
      "options": [
        {
          "id": "a",
          "text": "Leaves `a` as `false`"
        },
        {
          "id": "b",
          "text": "Assigns `10` to `a` because `false` is falsy"
        },
        {
          "id": "c",
          "text": "Raises `TypeError`"
        },
        {
          "id": "d",
          "text": "Only assigns if `a` is `nil`"
        }
      ],
      "code": {
        "language": "ruby",
        "source": "a = false\na ||= 10\np a"
      }
    },
    {
      "id": "q005",
      "type": "multi-select",
      "prompt": "Select all statements that are true about `Module` mixins in Ruby. (Select all that apply.)",
      "options": [
        {
          "id": "a",
          "text": "`extend Mod` adds `Mod`'s methods as class (singleton) methods"
        },
        {
          "id": "b",
          "text": "A class can only include one module"
        },
        {
          "id": "c",
          "text": "`include Mod` inserts `Mod` into the ancestor chain right above the class"
        },
        {
          "id": "d",
          "text": "`prepend Mod` inserts `Mod` *below* the class so `Mod` methods wrap/override the class's methods via `super`"
        }
      ]
    },

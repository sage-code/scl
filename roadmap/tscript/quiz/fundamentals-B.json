        },
        {
          "id": "b",
          "text": "Restricts `value` to `string`"
        },
        {
          "id": "c",
          "text": "Preserves the caller's specific type `T` from input to return value"
        },
        {
          "id": "d",
          "text": "Creates a runtime class"
        }
      ],
      "code": {
        "language": "typescript",
        "source": "function identity<T>(value: T): T {\n  return value;\n}"
      }

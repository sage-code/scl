        },
        {
          "id": "c",
          "text": "`if let` requires `return`"
        },
        {
          "id": "d",
          "text": "`guard let` binds `user` in the enclosing scope after the `guard`, and its `else` branch must exit scope (`return`/`throw`/`break`)"

      "prompt": "What is the difference between `val` and `var` in Scala?",
      "options": [
        {
          "id": "a",
          "text": "`val` is global; `var` is local"
        },
        {
          "id": "b",
          "text": "`val` declares an immutable binding; `var` declares a mutable variable"
        },
        {
          "id": "c",
          "text": "`var` is evaluated lazily"
        },
        {
          "id": "d",
          "text": "There is no difference"
        }

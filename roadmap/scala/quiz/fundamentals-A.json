    },
    {
      "id": "q002",
      "type": "single-choice",
      "prompt": "How does `lazy val x = compute()` behave compared to `val x = compute()` and `def x = compute()`?",
      "options": [
        {
          "id": "a",
          "text": "Runs on every access"
        },
        {
          "id": "b",
          "text": "Evaluates at compile time"
        },
        {
          "id": "c",
          "text": "Evaluates `compute()` at most once, on first access, and caches the result (thread-safely)"
        },
        {
          "id": "d",
          "text": "Never evaluates"
        }
      ]

    {
      "id": "q001",
      "type": "single-choice",
      "prompt": "What does `declare(strict_types=1);` at the top of a PHP file enforce?",
      "options": [
        {
          "id": "a",
          "text": "Variables cannot be reassigned"
        },
        {
          "id": "b",
          "text": "All properties become `readonly`"
        },
        {
          "id": "c",
          "text": "Function calls in that file must pass exact matching argument types (no silent string-to-int coercion)"
        },
        {
          "id": "d",
          "text": "Disables `null`"
        }
      ],
      "code": {
        "language": "php",
        "source": "declare(strict_types=1);\nfunction add(int $a, int $b): int { return $a + $b; }"
      }
    },
    {

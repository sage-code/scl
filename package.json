{
  "name": "sage-code-scl",
  "version": "1.0.41",
  "private": true,
  "description": "Sage-Code static website migration workspace (Vercel + Supabase backend).",
  "scripts": {
    "build": "node build.js",
    "build:full": "node -e \"process.env.BUILD_MODE='full'; require('./build.js')\"",
    "clean:only": "node scripts/clean-build.js",
    "clean": "node scripts/clean-build.js",
    "clean:rebuild": "node scripts/clean-build.js --rebuild",
    "test": "python scripts/test/test_sources.py",
    "check": "node scripts/check.js",
    "check:html": "python scripts/tools/check_html_fragments.py",
    "check:sidebar": "node scripts/tools/check_sidebar_render.js",
    "signature": "python scripts/tools/context_signature.py",
    "dev": "python scripts/tools/dev.py"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.6",
    "@vercel/speed-insights": "^1.0.10",
    "puppeteer": "^25.9.0"
  }
}
